; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false

[application]

config/name="Pasii"
run/main_scene="uid://c328xpxpi4l11"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/output_latency=4

[autoload]

AudioManager="*res://Globals/AudioManager.tscn"
ImGuiRoot="*res://addons/imgui-godot/data/ImGuiRoot.tscn"
TriggerActionClass="*res://Entities/Triggers/trigger_action.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"losotto": "res://StoryAndDialogue/losotto.dch",
"pasi": "res://StoryAndDialogue/pasi.dch"
}
directories/dtl_directory={
"tmln_test": "res://StoryAndDialogue/tmln_test.dtl",
"tmln_ulosotto": "res://StoryAndDialogue/tmln_ulosotto.dtl"
}
layout/style_directory={
"": "res://StoryAndDialogue/ykp_dialogic_styleB.tres",
"ykp_dialogic_style": "res://StoryAndDialogue/ykp_dialogic_style.tres",
"ykp_dialogic_styleB": "res://StoryAndDialogue/ykp_dialogic_styleB.tres"
}
layout/style_list=["res://StoryAndDialogue/ykp_dialogic_style.tres", "res://StoryAndDialogue/ykp_dialogic_styleB.tres"]
layout/default_style="res://StoryAndDialogue/ykp_dialogic_styleB.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
glossary/default_case_sensitive=true
variables={}

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Pasii"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/fancy_folder_icons/plugin.cfg", "res://addons/func_godot/plugin.cfg", "res://addons/imgui-godot/plugin.cfg")

[file_customization]

folder_colors={
"res://Audio/": "orange",
"res://Audio/Soundtextures/": "yellow",
"res://Entities/": "red",
"res://Globals/": "orange",
"res://Models/": "purple",
"res://Shaders/": "yellow",
"res://Tools/": "blue"
}

[global_group]

SM_Default="SM_ is a special prefix for sound materials. See the PlayerFootstepAudioManager scene"
SM_Roof=""

[gui]

theme/default_font_antialiasing=2

[importer_defaults]

scene={
&"blender/nodes/cameras": false,
&"meshes/light_baking": 2
}
3d_texture={
&"compress/mode": 0,
&"mipmaps/generate": false
}

