[ext_resource type="Texture2D" uid="uid://wn2ar6t7unvv" path="res://textures/texturebloat/BAADA8_ECE6E7_9A8378_E3DCD3.png" id="1_0a3rj"]

[sub_resource type="Shader" id="Shader_3ho5c"]
code = "/*
	Original
	MatCap Shader by Firerabbit
	MIT License
*/
/*
	Edited to include hue shift and vertex lighting by
	Modusmogulus

*/

shader_type spatial;

//render_mode unshaded;
render_mode vertex_lighting, blend_premul_alpha;
uniform sampler2D matcap : source_color, hint_default_black, filter_nearest, repeat_enable;
uniform float matcappiness : hint_range(0.0,1.0) = 1.0;
uniform vec4 texture_colorize : source_color = vec4(0.0);
uniform sampler2D albedo_texture : hint_default_transparent, filter_nearest, repeat_enable;
uniform sampler2D normal_texture : hint_normal;
uniform float vertex_shadow_strength : hint_range(0.0, 1.0);
uniform float matcap_hue_shift: hint_range(0.0, 1.0) = 0.0;
uniform float normal_strength : hint_range(0.0, 3.0, 0.001) = 0.0;
uniform vec2 tiling = vec2(1.0);
uniform vec2 move = vec2(0.0);
vec3 shift_hue(in vec3 color, in float shift) {
	//shift_hue by Benmo under CC0
	vec3 gray = vec3(0.57735);
	vec3 projection = gray * dot(gray, color);
	vec3 U = color - projection;
	vec3 V = cross(gray, U);
	vec3 shifted = U * cos(shift * 2.0 * PI) + V * sin(shift * 2.0 * PI) + projection;
	return shifted;
}

void fragment() {
	
	vec2 uv = tiling*UV + vec2(TIME*move.x*0.01, -TIME*move.y*0.01);
	vec2 uvb = tiling*UV + vec2(TIME*-move.x*0.01, TIME*move.y*0.01);
	
	vec3 normtex = mix(texture(normal_texture, uv).xyz, texture(normal_texture, uvb).xyz, 0.5);
	vec2 matcap_uv = (mix(NORMAL.xy, normtex.xy, normal_strength) * vec2(0.5, -0.5) + vec2(0.5, 0.5));
	vec3 alb1 = texture_colorize.rgb;
	vec3 mctex = texture(matcap, matcap_uv).rgb;
	mctex = shift_hue(mctex, matcap_hue_shift);
	vec4 t2 = texture(albedo_texture, normtex.xy);
	alb1 = mix(alb1.rgb, t2.rgb,  t2.a*0.5);
	alb1 *= mix(vec3(1.0), mctex, matcappiness);
	ALBEDO = alb1;
	ALPHA = texture_colorize.a;
	EMISSION = vec3(alb1.rgb * (1.0-vertex_shadow_strength));
}
"

